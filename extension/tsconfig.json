{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["chrome", "vite/client"],
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "paths": { "~/*": ["../app/*"], "#build/ui": ["../.nuxt/ui/index.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "../app/core/extension/**/*.ts"]
}
